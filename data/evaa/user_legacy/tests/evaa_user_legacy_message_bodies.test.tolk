import "@acton/fmt"
import "@acton/testing/expect"
import "../types/evaa_user_legacy.types"

get fun `test decodes packed withdraw user command`() {
    val body = parseCellFromBase64("");
    val decoded = EvaaUserLegacyPackedCommand.fromCell(body);

    expect(decoded.upgradeHeader.userCodeVersion).toEqual(6);
    val command = decoded.command;
    if (command is EvaaUserLegacyWithdrawUser) {
        expect(command.queryId).toEqual(0);
        expect(command.recipientAddress).toEqual(
            address("0:8D24B95DB3D4BE52BD4C1B0DE360C394BADA16B3FEBB4E95AC721BCE217D7E93"),
        );
    } else {
        throw 1;
    }
    expect(decoded.toCell().hash()).toEqual(body.hash());
}

get fun `test decodes packed withdraw success command`() {
    val body = parseCellFromBase64("te6cckEBAQEASAAAixBmAABCNAAAAAAAAAABspLfNk80nE2JPWy6uI+PNtv71C2Tdd9SKxT793eVgJQAAAAABHSmkgAAAAAAAAAAAAAAAAAAAAFafNdC");
    val decoded = EvaaUserLegacyPackedCommand.fromCell(body);

    expect(decoded.upgradeHeader.userCodeVersion).toEqual(6);
    val command = decoded.command;
    if (command is EvaaUserLegacyWithdrawSuccess) {
        expect(command.queryId).toEqual(0);
    } else {
        throw 1;
    }
    expect(decoded.toCell().hash()).toEqual(body.hash());
}

get fun `test decodes bare withdraw fail command`() {
    val body = parseCellFromBase64("te6cckEBAQEANgAAaAAAIR8AAAAAAAAAABpCGf5eYNY68qPMfc5v7Gm0XGtXGEl6YUjnwjKsh72KAAAAAAAHvpNpfmoa");
    val decoded = EvaaUserLegacyWithdrawFail.fromCell(body);

    expect(decoded.queryId).toEqual(0);
    expect(decoded.principalAmount).toEqual(507539);
    expect(decoded.toCell().hash()).toEqual(body.hash());
}

get fun `test decodes withdraw collateralized reply`() {
    val body = parseCellFromBase64("te6cckEBAwEAoAAB2wAAAhEAAAAAAAAAAIARpJcrtnqXylepg2G8bBhyl1tC1n/XadK1jkN5xC+v0nspLfNk80nE2JPWy6uI+PNtv71C2Tdd9SKxT793eVgJQAAAAAA5VdMAAAAAAAAAAAAAAAAAAAAAAAAAAABHSmkwAQFTgBGklyu2epfKV6mDYbxsGHKXW0LWf9dp0rWOQ3nEL6/SYAAAAAAAAAAQAgAADlUzYA==");
    val decoded = EvaaUserLegacyWithdrawCollateralized.fromCell(body);
    val extra = decoded.extra.load();

    expect(decoded.queryId).toEqual(0);
    expect(decoded.ownerAddress).toEqual(
        address("0:8D24B95DB3D4BE52BD4C1B0DE360C394BADA16B3FEBB4E95AC721BCE217D7E93"),
    );
    expect(extra.recipientAddress).toEqual(decoded.ownerAddress);
    expect(extra.forwardTonAmount).toEqual(0);
    expect(decoded.toCell().hash()).toEqual(body.hash());
}

get fun `test decodes withdraw excess bodies`() {
    val lockedBody = parseCellFromBase64("te6cckEBAQEADgAAGAAAIeYAAAAAAAAAAJLdD5c=");
    val notCollateralizedBody = parseCellFromBase64("te6cckEBAQEADgAAGAAAIecAAAAAAAAAANoLMWM=");
    val noFundsBody = parseCellFromBase64("te6cckEBAQEADgAAGAAhH+gAAAAAAAAAAKOpt1U=");
    val missingPricesBody = parseCellFromBase64("te6cckEBAQEADgAAGAAAIegAAAAAAAAAAFc3Ihw=");
    val textBody = parseCellFromBase64("te6cckEBAQEAFAAAJAAAAABFVkFBIHdpdGhkcmF3LrIBAgE=");

    expect(EvaaUserLegacyWithdrawLockedExcess.fromCell(lockedBody).toCell().hash()).toEqual(
        lockedBody.hash(),
    );
    expect(
        EvaaUserLegacyWithdrawNotCollateralizedExcess
            .fromCell(notCollateralizedBody)
            .toCell()
            .hash(),
    ).toEqual(notCollateralizedBody.hash());
    expect(EvaaUserLegacyWithdrawNoFundsExcess.fromCell(noFundsBody).toCell().hash()).toEqual(
        noFundsBody.hash(),
    );
    expect(
        EvaaUserLegacyWithdrawMissingPricesExcess.fromCell(missingPricesBody).toCell().hash(),
    ).toEqual(missingPricesBody.hash());
    expect(
        EvaaUserLegacyWithdrawExcessText.fromCell(textBody).text.remainingBitsCount(),
    ).toEqual(112);
}
